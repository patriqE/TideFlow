# Copy to .env for Docker Compose. Never commit your populated .env.
# Generate a private key: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PAYSTACK_SECRET_KEY=
# Optional: omit to use PAYSTACK_SECRET_KEY for webhook verification.
# PAYSTACK_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:8000
BOOKING_HOLD_MINUTES=15
